{
  "manifest_version": 3,
  "name": "My Simple Subtitle Tool",
  "version": "2.2",
  "description": "Finds and helps download subtitles for multiple languages with a persistent UI, Furigana, and Anki support.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "tabs"
  ],
  "action": {
    "default_title": "Open Subtitle Finder",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/subsrt.js",
        "lib/kuromoji.js",
        "src/content/content_script.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/subsrt.js",
        "assets/dict/*",
        "src/popup/popup.css",
        "lib/jszip.min.js",
        "lib/libarchive.js",
        "lib/libarchive.wasm",
        "lib/worker-bundle.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}